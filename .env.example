# Environment variables for Wyntrix Pixel Guard
# Copy this to .env in production

# JWT Secret for session cookie signing (must be at least 32 characters)
JWT_SECRET="wyntrix-pixel-guard-jwt-super-secret-key-production-replace-me"

# Prisma Database URL
# For SQLite (default file-based database):
DATABASE_URL="file:./dev.db"

# Node Environment
NODE_ENV="production"
